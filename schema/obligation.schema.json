{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "kind",
    "status",
    "title",
    "statement",
    "why_it_exists",
    "why_not_now",
    "scope",
    "tags",
    "completion",
    "created_at",
    "updated_at",
    "sources",
    "related"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^OBL-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{6}$"
    },
    "kind": {
      "enum": ["todo", "deferred", "watch", "validation_gap", "followup", "commitment", "revisit"]
    },
    "status": {
      "enum": ["open", "deferred", "blocked", "done", "cancelled", "superseded"]
    },
    "title": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "why_it_exists": {"type": "string", "minLength": 1},
    "why_not_now": {"type": "string"},
    "scope": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "trigger": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["on_touch", "before", "after", "on_change", "on_date", "condition", "manual"]},
        "value": {"type": "string", "minLength": 1},
        "reason": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "manual"}}, "required": ["type"]},
          "then": {"required": ["reason"], "properties": {"reason": {"minLength": 1}}}
        },
        {
          "if": {"properties": {"type": {"enum": ["on_touch", "before", "after", "on_change", "on_date", "condition"]}}, "required": ["type"]},
          "then": {"required": ["value"]}
        }
      ],
      "additionalProperties": false
    },
    "completion": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "reference"],
        "properties": {
          "type": {"enum": ["chat_session", "git_commit", "ci_run", "worker_handoff", "repository_file", "audit", "research", "user_statement"]},
          "reference": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "related": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(MEM-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{6}|OBL-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{6}|ADR-[0-9]{4})$"}
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(MEM-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{6}|OBL-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{6}|ADR-[0-9]{4})$"}
    },
    "superseded_by": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(MEM-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{6}|OBL-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{6}|ADR-[0-9]{4})$"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["open", "deferred", "blocked"]}}, "required": ["status"]},
      "then": {"required": ["trigger"]}
    },
    {
      "if": {"properties": {"status": {"const": "superseded"}}, "required": ["status"]},
      "then": {"required": ["superseded_by"], "properties": {"superseded_by": {"minItems": 1}}}
    }
  ],
  "additionalProperties": false
}
