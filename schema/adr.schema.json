{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "status", "title", "scope", "tags", "created_at", "updated_at", "sources", "related", "supersedes", "superseded_by"],
  "properties": {
    "id": {"type": "string", "pattern": "^ADR-[0-9]{4}$"},
    "status": {"enum": ["proposed", "accepted", "superseded", "rejected"]},
    "title": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "reference"],
        "properties": {
          "type": {"enum": ["chat_session", "git_commit", "ci_run", "worker_handoff", "repository_file", "audit", "research", "user_statement"]},
          "reference": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "related": {"type": "array", "items": {"type": "string", "pattern": "^(MEM-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{6}|OBL-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{6}|ADR-[0-9]{4})$"}},
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(MEM-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{6}|OBL-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{6}|ADR-[0-9]{4})$"}},
    "superseded_by": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(MEM-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{6}|OBL-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{6}|ADR-[0-9]{4})$"}}
  },
  "additionalProperties": false
}
