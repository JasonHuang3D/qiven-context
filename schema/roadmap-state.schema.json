{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "classification",
    "immutable_architecture",
    "updated_at",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "classification": {
      "const": "plan"
    },
    "immutable_architecture": {
      "const": false
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "order",
          "title"
        ],
        "properties": {
          "order": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
