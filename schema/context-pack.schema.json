{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qiven-context/context-pack.schema.json",
  "title": "Qiven Generated Context Pack",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "query",
    "mandatory_sources",
    "projects",
    "decisions",
    "memory",
    "obligations",
    "diagnostics",
    "snapshot",
    "source_contents",
    "constraints",
    "readiness",
    "authorization",
    "budget"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "query": {
      "$ref": "context-query.schema.json"
    },
    "mandatory_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selection"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selection"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selection"
      }
    },
    "memory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selection"
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation_selection"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "level",
          "code",
          "message"
        ],
        "properties": {
          "level": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "snapshot": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "git_commit",
        "git_tree",
        "files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "git-commit",
            "quiescent-directory"
          ]
        },
        "git_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_tree": {
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "additionalProperties": false
    },
    "source_contents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "snapshot_id",
          "sha256",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "snapshot_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "content": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "scope",
        "authorization",
        "operation_declared",
        "status",
        "prohibited",
        "rules"
      ],
      "properties": {
        "scope": {
          "const": "declared-rules-and-record-constraints"
        },
        "authorization": {
          "const": "not_granted"
        },
        "operation_declared": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "resolved",
            "unresolved"
          ]
        },
        "prohibited": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "effect",
              "applicability",
              "sources"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "effect": {
                "enum": [
                  "require",
                  "prohibit",
                  "review_required"
                ]
              },
              "applicability": {
                "enum": [
                  "applicable",
                  "not_applicable",
                  "unresolved"
                ]
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "readiness": {
      "enum": [
        "context_loaded",
        "review_required"
      ]
    },
    "authorization": {
      "const": "not_granted"
    },
    "budget": {
      "type": "object",
      "required": [
        "limit_bytes",
        "omitted"
      ],
      "properties": {
        "limit_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "omitted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "selection_reason": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "mandatory",
            "explicit_id",
            "scope_match",
            "tag_match",
            "project_match",
            "title_match",
            "content_match",
            "related_record",
            "trigger_due",
            "trigger_applicable"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": [
        "path",
        "reasons"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "id"
            ]
          },
          "then": {
            "required": [
              "status",
              "current_eligible",
              "supersedes",
              "superseded_by",
              "evidence"
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "current_eligible": {
          "type": "boolean"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "superseded_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/selection_reason"
          }
        },
        "evidence": {
          "type": "object",
          "required": [
            "category",
            "metadata",
            "body",
            "source"
          ],
          "properties": {
            "category": {
              "enum": [
                "decisions",
                "memory",
                "obligations"
              ]
            },
            "metadata": {
              "type": "object"
            },
            "body": {
              "type": "string"
            },
            "source": {
              "type": "object",
              "required": [
                "path",
                "snapshot_id",
                "sha256",
                "content"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "snapshot_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "content": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "trigger_evaluation": {
      "type": "object",
      "required": [
        "type",
        "result",
        "explanation"
      ],
      "properties": {
        "type": {
          "enum": [
            "on_touch",
            "before",
            "after",
            "on_change",
            "on_date",
            "condition",
            "manual",
            "inactive"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "due",
            "applicable",
            "not_triggered",
            "manual",
            "unresolved",
            "inactive"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "obligation_selection": {
      "type": "object",
      "required": [
        "id",
        "path",
        "status",
        "current_eligible",
        "supersedes",
        "superseded_by",
        "reasons",
        "trigger",
        "completion",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^OBL-[0-9]{8}T[0-9]{6}Z-[A-F0-9]{6}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "open",
            "deferred",
            "blocked",
            "done",
            "cancelled",
            "superseded"
          ]
        },
        "current_eligible": {
          "type": "boolean"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "superseded_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/selection_reason"
          }
        },
        "trigger": {
          "$ref": "#/$defs/trigger_evaluation"
        },
        "completion": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "object",
          "required": [
            "category",
            "metadata",
            "body",
            "source"
          ],
          "properties": {
            "category": {
              "enum": [
                "decisions",
                "memory",
                "obligations"
              ]
            },
            "metadata": {
              "type": "object"
            },
            "body": {
              "type": "string"
            },
            "source": {
              "type": "object",
              "required": [
                "path",
                "snapshot_id",
                "sha256",
                "content"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "snapshot_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "content": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
