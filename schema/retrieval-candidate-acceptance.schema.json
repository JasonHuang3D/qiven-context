{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qiven-context/retrieval-candidate-acceptance.schema.json",
  "title": "Qiven Retrieval Candidate Acceptance",
  "type": "object",
  "required": ["schema_version", "name", "frozen_candidate", "max_candidates", "thresholds", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "frozen_candidate": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "max_candidates": {"type": "integer", "minimum": 1, "maximum": 8},
    "thresholds": {
      "type": "object",
      "required": ["positive_required_id_recall_min", "positive_top1_required_rate_min", "forbidden_top1_hits_max"],
      "properties": {
        "positive_required_id_recall_min": {"type": "number", "minimum": 0, "maximum": 1},
        "positive_top1_required_rate_min": {"type": "number", "minimum": 0, "maximum": 1},
        "forbidden_top1_hits_max": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "critical", "query", "required_ids", "forbidden_ids", "cognition_expectation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "kind": {"enum": ["positive", "negative"]},
          "critical": {"type": "boolean"},
          "query": {"type": "object"},
          "required_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "forbidden_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "cognition_expectation": {"enum": ["answer", "abstain"]},
          "rationale": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
