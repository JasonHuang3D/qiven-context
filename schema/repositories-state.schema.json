{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "repositories"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "remote",
          "local_path",
          "default_branch",
          "main_sha",
          "observed_at",
          "authority"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "remote": {
            "type": "string",
            "minLength": 1
          },
          "local_path": {
            "type": "string"
          },
          "default_branch": {
            "type": "string"
          },
          "main_sha": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "authority": {
            "const": "live_git"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
