{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qiven-context/retrieval-benchmark.schema.json",
  "title": "Qiven Retrieval Benchmark",
  "type": "object",
  "required": ["schema_version", "name", "thresholds", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "thresholds": {
      "type": "object",
      "required": ["critical_case_recall_min", "required_id_recall_min", "forbidden_hits_max", "mean_extra_ids_max"],
      "properties": {
        "critical_case_recall_min": {"type": "number", "minimum": 0, "maximum": 1},
        "required_id_recall_min": {"type": "number", "minimum": 0, "maximum": 1},
        "forbidden_hits_max": {"type": "integer", "minimum": 0},
        "mean_extra_ids_max": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "query", "required_ids", "forbidden_ids", "allowed_extra_ids", "critical"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "query": {"$ref": "context-query.schema.json"},
          "required_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "forbidden_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowed_extra_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "critical": {"type": "boolean"},
          "rationale": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
